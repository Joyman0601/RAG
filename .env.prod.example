# 生产环境变量模板
# 用法：
#   cp .env.prod.example .env.prod
#   编辑 .env.prod 填入真实值
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# 【重要】.env.prod 已在 .gitignore 中，不要提交到仓库

# ================= 数据库 =================
PG_DB=rag
PG_USER=rag
# 必填：随机 24 位以上密码，例：openssl rand -base64 24
PG_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# ================= 向量维度 =================
# 必须与 embedding 模型输出一致：
#   - text-embedding-3-small = 1536
#   - text-embedding-v4 (DashScope, 默认) = 1024
#   - bge-m3 = 1024
#   - qwen3-embedding-8b = 4096
VECTORSTORE_DIMENSION=1024

# ================= LLM（chat 主模型） =================
# 独立演示 key，与生产/学习环境隔离；平台建议 DashScope / DeepSeek / SiliconFlow
LLM_API_KEY=sk-your-demo-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 除非平台强制 Responses API，否则一律用 chat（走 /v1/chat/completions）
LLM_API_STYLE=chat
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=800

# ================= Embedding =================
LLM_EMBEDDING_API_KEY=sk-your-demo-key
LLM_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_EMBEDDING_MODEL=text-embedding-v4
# openai | dashscope-multimodal
LLM_EMBEDDING_STYLE=openai

# ================= Rerank（可选） =================
# 留空则 hybrid+rerank 模式降级为普通 hybrid；SiliconFlow 新用户有免费额度
LLM_RERANK_API_KEY=sk-your-siliconflow-key
LLM_RERANK_BASE_URL=https://api.siliconflow.cn/v1
LLM_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ================= Step 4 加固 =================
# 面试官凭证：README 里给出 URL query 或 header 方式
# 建议 32 位随机字符串：openssl rand -hex 16
DEMO_TOKEN=CHANGE_ME_RANDOM_32CHAR

# 生产禁上传（面试官只读知识库）
DEMO_UPLOAD_ENABLED=false

# 日 LLM 调用上限，超了返回 "演示额度已用完，请查看录屏"
MAX_DAILY_LLM_CALLS=500

# Bucket4j 应用层限流（Nginx 限流为主，此为二道防线，默认关）
DEMO_RATE_LIMIT_ENABLED=false
DEMO_RATE_LIMIT_RPM=10

# ================= Langfuse 观测（Step 5 打开） =================
LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
