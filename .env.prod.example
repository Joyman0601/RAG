# 生产环境变量模板
# 用法：
#   cp .env.prod.example .env.prod
#   编辑 .env.prod 填入真实值
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# 【重要】.env.prod 已在 .gitignore 中，不要提交到仓库

# ================= 数据库 =================
PG_DB=rag
PG_USER=rag
# 必填：随机 24 位以上密码，例：openssl rand -base64 24
PG_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# ================= 向量维度 =================
# 必须与 embedding 模型输出一致：
#   - text-embedding-3-small = 1536
#   - text-embedding-v4 (DashScope, 默认) = 1024
#   - bge-m3 = 1024
#   - qwen3-embedding-8b = 4096
VECTORSTORE_DIMENSION=1024

# ================= LLM（chat 主模型） =================
# 独立演示 key，与生产/学习环境隔离；平台建议 DashScope / DeepSeek / SiliconFlow
LLM_API_KEY=sk-your-demo-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 除非平台强制 Responses API，否则一律用 chat（走 /v1/chat/completions）
LLM_API_STYLE=chat
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=800

# ================= Embedding =================
LLM_EMBEDDING_API_KEY=sk-your-demo-key
LLM_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_EMBEDDING_MODEL=text-embedding-v4
# openai | dashscope-multimodal
LLM_EMBEDDING_STYLE=openai

# ================= Rerank（可选） =================
# 留空则 hybrid+rerank 模式降级为普通 hybrid；SiliconFlow 新用户有免费额度
LLM_RERANK_API_KEY=sk-your-siliconflow-key
LLM_RERANK_BASE_URL=https://api.siliconflow.cn/v1
LLM_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ================= Step 4 加固 =================
# 面试官凭证：README 里给出 URL query 或 header 方式
# 建议 32 位随机字符串：openssl rand -hex 16
DEMO_TOKEN=CHANGE_ME_RANDOM_32CHAR

# 生产禁上传（面试官只读知识库）
DEMO_UPLOAD_ENABLED=false

# 日 LLM 调用上限，超了返回 "演示额度已用完，请查看录屏"
MAX_DAILY_LLM_CALLS=500

# Bucket4j 应用层限流（Nginx 限流为主，此为二道防线，默认关）
DEMO_RATE_LIMIT_ENABLED=false
DEMO_RATE_LIMIT_RPM=10

# ================= Langfuse 观测（Step 5 打开） =================
# 流程：
#   1) 起 langfuse stack 前，先随机三个密钥填下面 3 个变量
#      openssl rand -base64 24  → LANGFUSE_POSTGRES_PASSWORD
#      openssl rand -base64 32  → LANGFUSE_NEXTAUTH_SECRET
#      openssl rand -base64 32  → LANGFUSE_SALT
#   2) docker compose -f docker-compose.langfuse.yml --env-file .env.prod up -d
#   3) 通过 https://observability.rag.chandlerblog.com 注册 root、建 project、生成 pk/sk
#   4) 把 pk/sk 填到下面，然后把 LANGFUSE_ENABLED 改成 true
#   5) docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --force-recreate app
#
# 注意：pk/sk 未就绪前 LANGFUSE_ENABLED 保持 false，否则每次 LLM 调用都会打 warn 日志

# Langfuse Postgres 数据库密码（仅 langfuse 栈内部使用，独立于 PG_PASSWORD）
LANGFUSE_POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# NextAuth 相关（首次起服务前必填，随机生成）
LANGFUSE_NEXTAUTH_URL=https://observability.rag.chandlerblog.com
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
LANGFUSE_SALT=CHANGE_ME_openssl_rand_base64_32
# root 用户注册完后改成 true，防被薅额度
LANGFUSE_AUTH_DISABLE_SIGNUP=false

# Spring Boot 侧上报开关（拿到 pk/sk 后改 true）
LANGFUSE_ENABLED=false
# app 通过 docker 内网直通 langfuse-server，无需走公网域名
LANGFUSE_HOST=http://langfuse-server:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
